{
  "profile": "product-admin",
  "sourceRoots": [
    "prototype",
    "index.html",
    "workbench.js",
    "workbench.css",
    "development-review.js",
    "backend-logic-review.js"
  ],
  "locale": "zh-CN",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Form",
    "Scrollbar",
    "Toast",
    "CRUD"
  ],
  "ownership": {
    "Select/Listbox": "native"
  },
  "requiredCommands": [
    "themes",
    "runtime",
    "visual",
    "recordContract",
    "motion",
    "previewUI",
    "navigation",
    "workbench",
    "development",
    "backendLogic",
    "homeExplore",
    "productStructure"
  ],
  "commands": {
    "themes": "python tools/build_themes.py",
    "runtime": "python tools/hosted_smoke.py .",
    "visual": "python tools/design_snapshots.py .",
    "recordContract": "node tools/record_loop_contract.mjs .",
    "motion": "python tools/tidal_motion.py .",
    "previewUI": "python tools/six_paths_ui.py .",
    "navigation": "python tools/nav_contrast.py .",
    "workbench": "python tools/build_workbench.py && python tools/workbench_coverage.py .",
    "development": "python tools/development_review_test.py .",
    "backendLogic": "python tools/backend_logic_test.py .",
    "homeExplore": "python tools/home_explore_review.py .",
    "productStructure": "python tools/product_structure_review.py ."
  },
  "evidence": {
    "crudFullFlow": "tools/hosted_smoke.py",
    "failurePaths": "tools/hosted_smoke.py",
    "localCatalogSearch": "tools/home_explore_review.py"
  }
}
